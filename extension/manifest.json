{
  "manifest_version": 3,
  "name": "Stream Command Watchlist Importer",
  "version": "0.2.0",
  "description": "Securely imports watchlist metadata into Stream Command Center.",
  "key": "",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.disneyplus.com/*",
    "https://www.hulu.com/*",
    "https://www.max.com/*",
    "https://www.paramountplus.com/*",
    "https://www.peacocktv.com/*",
    "https://tv.apple.com/*",
    "https://www.tubitv.com/*",
    "https://tubitv.com/*",
    "https://www.crunchyroll.com/*",
    "https://www.mgmplus.com/*",
    "https://www.starz.com/*",
    "https://www.amcplus.com/*",
    "https://www.discoveryplus.com/*",
    "https://www.espn.com/*",
    "https://www.fubo.tv/*",
    "https://www.sling.com/*",
    "https://tv.youtube.com/*",
    "https://www.philo.com/*",
    "https://www.britbox.com/*",
    "https://acorn.tv/*",
    "https://www.shudder.com/*",
    "https://mubi.com/*",
    "https://www.hallmarkplus.com/*",
    "https://www.criterionchannel.com/*",
    "https://www.dropout.tv/*",
    "https://www.hidive.com/*",
    "https://pluto.tv/*",
    "https://www.roku.com/*",
    "https://www.plex.tv/*",
    "https://stream-command-center-three.vercel.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "provider-adapters.js",
        "netflix-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hulu.com/*"
      ],
      "js": [
        "provider-adapters.js",
        "hulu-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.peacocktv.com/*"
      ],
      "js": [
        "provider-adapters.js",
        "peacock-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.disneyplus.com/*",
        "https://www.max.com/*",
        "https://www.paramountplus.com/*",
        "https://tv.apple.com/*",
        "https://www.tubitv.com/*",
        "https://tubitv.com/*",
        "https://www.crunchyroll.com/*",
        "https://www.mgmplus.com/*",
        "https://www.starz.com/*",
        "https://www.amcplus.com/*",
        "https://www.discoveryplus.com/*",
        "https://www.espn.com/*",
        "https://www.fubo.tv/*",
        "https://www.sling.com/*",
        "https://tv.youtube.com/*",
        "https://www.philo.com/*",
        "https://www.britbox.com/*",
        "https://acorn.tv/*",
        "https://www.shudder.com/*",
        "https://mubi.com/*",
        "https://www.hallmarkplus.com/*",
        "https://www.criterionchannel.com/*",
        "https://www.dropout.tv/*",
        "https://www.hidive.com/*",
        "https://pluto.tv/*",
        "https://www.roku.com/*",
        "https://www.plex.tv/*"
      ],
      "js": [
        "provider-adapters.js",
        "saved-library-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://stream-command-center-three.vercel.app/*"
      ],
      "js": [
        "scc-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://stream-command-center-three.vercel.app/*"
    ]
  }
}
